<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <if condition="{loadLate()}">
        Other text
    </if>
    <p>This should be rendered before the other text.</p>

    <script>
        async function loadLate() {
            await new Promise(resolve => setTimeout(resolve, 3000));
            return true;
        }
    </script>
</body>

</html>